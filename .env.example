# Optional Vercel BUILD environment variables. These are public configuration, not secrets.
# Default: a public-only portfolio, with no academic workspace bundle.
ARCHISPACE_DEPLOY_TARGET=portfolio
# Leave URL blank until a domain is chosen/connected; example only:
PUBLIC_SITE_URL=
PUBLIC_SITE_TITLE=ArchiSpace · Archit Renjeev
PUBLIC_SITE_DESCRIPTION=ArchiSpace by Archit Renjeev — backend-focused developer and AI & Data Science student.
# A separate project may use ARCHISPACE_DEPLOY_TARGET=workspace.
# Never place AI API keys, Supabase service-role keys, passwords or private backups here.
